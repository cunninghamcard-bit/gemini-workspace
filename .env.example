# Optional environment overrides for `gemini-workspace serve`
# Configuration normally lives in ~/.devspace/config.jsonc and ~/.devspace/auth.json

# Override the local TCP port without changing server.publicBaseUrl
# DEVSPACE_LISTEN_PORT=7676

# Override owner password (otherwise read from ~/.devspace/auth.json)
# DEVSPACE_OAUTH_OWNER_TOKEN=replace-with-at-least-16-char-secret

# Default working directory for run_command
# DEVSPACE_AGY_WORKSPACE=~

# Toggle Code Mode (`execute`, `poll_execution`, `cancel_execution`)
# DEVSPACE_CODE_MODE=1
