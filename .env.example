# Optional environment overrides for `gemini-workspace serve`
# Configuration normally lives in ~/.gemini-workspace/config.jsonc and ~/.gemini-workspace/auth.json

# Override the local TCP port without changing server.publicBaseUrl
# GEMINI_WORKSPACE_LISTEN_PORT=7676

# Override owner password (otherwise read from ~/.gemini-workspace/auth.json)
# GEMINI_WORKSPACE_OAUTH_OWNER_TOKEN=replace-with-at-least-16-char-secret

# Default working directory for run_command
# GEMINI_WORKSPACE_AGY_WORKSPACE=~

# Toggle Code Mode (`execute`, `poll_execution`, `cancel_execution`)
# GEMINI_WORKSPACE_CODE_MODE=1
